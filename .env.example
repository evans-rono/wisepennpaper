NODE_ENV=development
PORT=3000
DB_PATH=wise-pen.db
SESSION_SECRET=replace-with-at-least-32-random-characters
BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@wisepennpaper.co.ke
ADMIN_PASSWORD=ChangeMe-Now-2026!
# The seed creates the admin account with ADMIN_PASSWORD. If the account already
# exists with a different password it is now left alone -- changing the password
# in the dashboard and re-running the seed used to put the old one back. Set
# this to "on" for a deliberate reset.
ADMIN_PASSWORD_ROTATE=off
# Outgoing mail (password resets, sign-in alerts, new-enquiry notices).
#
# Gmail / Google Workspace:
#   1. Turn on 2-Step Verification for the sending Google account.
#   2. Create an App Password (Google Account > Security > App passwords) and
#      paste its 16 characters into SMTP_PASS, spaces removed. A normal account
#      password will not work.
#   3. SMTP_USER is the full Gmail address, and MAIL_FROM should use that same
#      address -- Gmail rewrites any other From unless it is a verified
#      "Send mail as" alias. Left blank, SMTP_USER is used.
#   Port 587 with SMTP_SECURE=off (STARTTLS), or port 465 with SMTP_SECURE=on.
#   Limits: roughly 500 recipients/day on gmail.com, 2,000 on Workspace.
# cPanel hosting: many shared hosts block outbound SMTP to other providers, so
# Gmail may simply time out. Create a mailbox in cPanel > Email Accounts and use
# it instead -- SMTP_HOST=mail.<yourdomain>, SMTP_PORT=465, SMTP_SECURE=on,
# SMTP_USER/MAIL_FROM set to that mailbox. Mail from your own domain also passes
# SPF/DKIM, which cPanel configures, so less of it is filtered as spam.
#
# Verify the settings with: npm run mail:test you@example.com
#
# With no terminal (cPanel "Run JS script" cannot pass arguments), set the two
# below instead and run mail:test / reset:test with no arguments. They are test
# scaffolding: clear them once both pass.
MAIL_TEST_TO=
RESET_TEST_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wise Pen N Paper <no-reply@wisepennpaper.co.ke>
ALERT_EMAIL=admin@wisepennpaper.co.ke
SMTP_SECURE=off

# Password recovery and sign-in alert links use BASE_URL and SMTP. In
# production, SMTP_HOST must be set or auth notifications fail closed.
PASSWORD_RESET_TTL_MINUTES=30

# Uploads: local is suitable for development and one-server deployments.
# S3-compatible providers (AWS S3, R2, GCS interoperability) use the values below.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=off
S3_SSE=

# Uploads are scanned by ClamAV before they are persisted. In production the
# app refuses to start if the scanner is named but missing, rather than failing
# one upload at a time: shared hosting rarely carries the clamscan CLI. If your
# host scans the filesystem out of band (cPanel ImunifyAV and similar), set this
# to "off" deliberately -- the app then boots and logs that it is unscanned.
MALWARE_SCAN=off
CLAMSCAN_PATH=clamscan

# Failed sign-in / registration attempts allowed per IP per 15 minutes.
# Successful sign-ins never count towards it, so ordinary use never approaches
# this figure however many times someone signs in and out.
AUTH_RATE_LIMIT=50
# Requests per minute per IP across /api. Signed-in clients get four times this
# and staff are exempt; before, signing in removed the limit entirely, which
# made registering an account the cheapest way around it.
API_RATE_LIMIT=600
# Quote submissions per hour per IP. They accept five 15 MB attachments from
# anyone, and those files share a disk with the database, so a full disk stops
# writes to both. Staff are exempt.
UPLOAD_RATE_LIMIT=10
# Redirect plain HTTP to HTTPS in production. Session and CSRF cookies are
# Secure, so without this a visitor on http:// sends their password in clear
# text and then cannot sign in anyway. Only set "off" behind a proxy that
# already redirects.
FORCE_HTTPS=on
# npm run backup writes here, keeping the newest BACKUP_KEEP copies.
BACKUP_DIR=backups
BACKUP_KEEP=7
# Number of reverse proxies in front of the app (production only). req.ip is
# read from X-Forwarded-For, so this must match the real deployment: set it too
# high and a caller can spoof their address. Use 0 if nothing fronts the app.
TRUST_PROXY=1
# New passwords are screened against the Have I Been Pwned breach corpus using
# the k-anonymity range API: only the first five characters of the password's
# SHA-1 leave this server, never the password. It fails open if the call fails.
# Set to "off" only if the host blocks outbound HTTPS.
# Minimum length is 12 characters for clients and 16 for staff and admins.
PWNED_CHECK=on

# Two-step verification is required for admin and super_admin accounts. Set to
# "off" only for local development; it leaves the highest-privilege accounts on
# a password alone.
REQUIRE_ADMIN_2FA=on

# Sign in with Google (optional). Create an OAuth 2.0 Web application client in
# the Google Cloud console and add this exact redirect URI:
#   <BASE_URL>/api/auth/google/callback
# Leave both blank to hide the button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict sign-in to one or more Google Workspace domains, comma separated.
# Leave blank to accept any Google account (which only ever creates a client
# account, never staff).
GOOGLE_ALLOWED_DOMAINS=

# Keep SQL isolated behind the repository adapter as the deployment moves to
# PostgreSQL. The current schema remains SQLite-compatible for local operation.
DB_DIALECT=sqlite
